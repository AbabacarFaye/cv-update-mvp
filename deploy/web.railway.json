{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "Dockerfile.web", "watchPatterns": ["/apps/web/**", "/packages/**", "/pnpm-lock.yaml", "/Dockerfile.web", "/deploy/web.railway.json"] },
  "deploy": { "healthcheckPath": "/api/health/live", "healthcheckTimeout": 60, "restartPolicyType": "ON_FAILURE", "restartPolicyMaxRetries": 5 }
}
