# Service Railway worker. Aucun domaine public ni credential d'administration.
APP_ENV=validation
APP_ORIGIN=
FOUNDATION_DEMO_ENABLED=true
# Rôle PostgreSQL foundation_worker, connexion TLS vérifiée.
WORKER_DATABASE_URL=
R2_ENDPOINT=
R2_BUCKET=
# Credentials R2 limités à l'écriture du bucket de validation.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
