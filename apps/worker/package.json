{
  "name": "@cv/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=../../.env.worker src/index.ts",
    "start": "node dist/index.js",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --external:postgres --external:@aws-sdk/* --outfile=dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/s3-request-presigner": "3.1164.0",
    "@cv/contracts": "workspace:*",
    "@cv/server": "workspace:*",
    "postgres": "4.1.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
